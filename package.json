{
  "name": "ai-audit",
  "version": "1.0.0",
  "description": "Local audit proxy for OpenAI & Anthropic APIs: secret/PII redaction, hash-chained AI Act-style audit log",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "build:fast": "tsrs --skipLibCheck",
    "test": "npm run build && node --test dist/test/*.test.js",
    "fuzz": "npm run build && FUZZ_SCALE=${FUZZ_SCALE:-50} node --test dist/test/fuzz.test.js",
    "fuzz:coverage": "npm run build && bash fuzz/run.sh",
    "demo": "npm run build && node dist/src/demo.js",
    "example:quote": "node examples/quineling-quote/run.mjs",
    "example:llm-policy": "node examples/quineling-quote/llm-policy.mjs",
    "bench:overhead": "npm run build && node bench/overhead.mjs",
    "check:tsc": "tsc --noEmit",
    "verify:formal": "bash spec/run.sh && npm run build && node --test dist/test/logsafety.test.js dist/test/audit.test.js dist/test/qdl.test.js dist/test/laws.test.js",
    "verify:bend": "bash bend/run.sh"
  },
  "keywords": [
    "ai-act",
    "llm",
    "proxy",
    "audit",
    "openai",
    "anthropic"
  ],
  "author": "Adrian Góra",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "^24.19.2",
    "openai": "^6.49.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@quinelings/agent-sdk": "file:vendor/quinelings-agent-sdk-1.0.0.tgz"
  },
  "bin": {
    "ai-audit": "dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adagora/ai-audit.git"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  }
}
