{
  "format": "qdl-intent",
  "version": 1,
  "name": "Wycena narzędziowni v1 (przykładowe stawki rynkowe)",
  "thought": "Koszt partii = materiał + przygotowanie + programowanie + obróbka + operacje ręczne + kontrola + kooperacja, plus rezerwa 10 %; cena = koszt + narzut 25 %. Godziny i masę podaje LLM, stawki są stałymi firmy. Do kierownika, gdy materiału nie ma na rysunku, jest kooperacja, pewność LLM jest poniżej 0,7 albo cena przekracza 5000 PLN.",
  "inputs": [
    { "id": "quantity", "name": "quantity", "type": { "kind": "number", "unit": "one", "integer": true, "min": 1 } },
    { "id": "blankKg", "name": "blankKg", "type": { "kind": "number", "unit": "kg", "min": 0 } },
    { "id": "materialStated", "name": "materialStated", "type": { "kind": "boolean" } },
    { "id": "cnc5Hours", "name": "cnc5Hours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "cncHours", "name": "cncHours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "conventionalHours", "name": "conventionalHours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "setupHours", "name": "setupHours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "programmingHours", "name": "programmingHours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "manualHours", "name": "manualHours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "inspectionHours", "name": "inspectionHours", "type": { "kind": "number", "unit": "h", "min": 0 } },
    { "id": "cooperationCost", "name": "cooperationCost", "type": { "kind": "number", "unit": "PLN", "min": 0 } },
    { "id": "confidence", "name": "confidence", "type": { "kind": "number", "unit": "one", "min": 0, "max": 1 } },
    { "id": "steelPrice", "value": 6.0, "type": { "kind": "number", "unit": "PLN*kg^-1", "min": 0 } },
    { "id": "rateCnc5", "value": 240, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "rateCnc", "value": 150, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "rateConventional", "value": 105, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "setupRate", "value": 120, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "programmingRate", "value": 150, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "manualRate", "value": 80, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "inspectionRate", "value": 110, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "workerCost", "value": 65, "type": { "kind": "number", "unit": "PLN*h^-1", "min": 0 } },
    { "id": "reservePct", "value": 0.1, "type": { "kind": "number", "unit": "one", "min": 0 } },
    { "id": "markupPct", "value": 0.25, "type": { "kind": "number", "unit": "one", "min": 0 } },
    { "id": "yes", "value": true, "type": { "kind": "boolean" } }
  ],
  "steps": [
    { "id": "materialPerPiece", "op": "arithmetic", "inputs": ["blankKg", "steelPrice"], "params": { "kind": "mul" } },
    { "id": "material", "op": "arithmetic", "inputs": ["materialPerPiece", "quantity"], "params": { "kind": "mul" } },
    { "id": "onCnc5", "op": "arithmetic", "inputs": ["cnc5Hours", "rateCnc5"], "params": { "kind": "mul" } },
    { "id": "onCnc", "op": "arithmetic", "inputs": ["cncHours", "rateCnc"], "params": { "kind": "mul" } },
    { "id": "onConventional", "op": "arithmetic", "inputs": ["conventionalHours", "rateConventional"], "params": { "kind": "mul" } },
    { "id": "onAllCnc", "op": "arithmetic", "inputs": ["onCnc5", "onCnc"], "params": { "kind": "add" } },
    { "id": "machining", "op": "arithmetic", "inputs": ["onAllCnc", "onConventional"], "params": { "kind": "add" } },
    { "id": "preparation", "op": "arithmetic", "inputs": ["setupHours", "setupRate"], "params": { "kind": "mul" } },
    { "id": "programming", "op": "arithmetic", "inputs": ["programmingHours", "programmingRate"], "params": { "kind": "mul" } },
    { "id": "manual", "op": "arithmetic", "inputs": ["manualHours", "manualRate"], "params": { "kind": "mul" } },
    { "id": "inspection", "op": "arithmetic", "inputs": ["inspectionHours", "inspectionRate"], "params": { "kind": "mul" } },
    { "id": "withPreparation", "op": "arithmetic", "inputs": ["material", "preparation"], "params": { "kind": "add" } },
    { "id": "withProgramming", "op": "arithmetic", "inputs": ["withPreparation", "programming"], "params": { "kind": "add" } },
    { "id": "withMachining", "op": "arithmetic", "inputs": ["withProgramming", "machining"], "params": { "kind": "add" } },
    { "id": "withManual", "op": "arithmetic", "inputs": ["withMachining", "manual"], "params": { "kind": "add" } },
    { "id": "withInspection", "op": "arithmetic", "inputs": ["withManual", "inspection"], "params": { "kind": "add" } },
    { "id": "subtotal", "op": "arithmetic", "inputs": ["withInspection", "cooperationCost"], "params": { "kind": "add" } },
    { "id": "reserve", "op": "arithmetic", "inputs": ["subtotal", "reservePct"], "params": { "kind": "mul" } },
    { "id": "cost", "op": "arithmetic", "inputs": ["subtotal", "reserve"], "params": { "kind": "add" } },
    { "id": "profit", "op": "arithmetic", "inputs": ["cost", "markupPct"], "params": { "kind": "mul" } },
    { "id": "price", "op": "arithmetic", "inputs": ["cost", "profit"], "params": { "kind": "add" } },
    { "id": "pricePerPiece", "op": "arithmetic", "inputs": ["price", "quantity"], "params": { "kind": "div" } },
    { "id": "marginOfPrice", "op": "arithmetic", "inputs": ["profit", "price"], "params": { "kind": "div" } },
    { "id": "cncMachineHours", "op": "arithmetic", "inputs": ["cnc5Hours", "cncHours"], "params": { "kind": "add" } },
    { "id": "machineHours", "op": "arithmetic", "inputs": ["cncMachineHours", "conventionalHours"], "params": { "kind": "add" } },
    { "id": "withSetupHours", "op": "arithmetic", "inputs": ["machineHours", "setupHours"], "params": { "kind": "add" } },
    { "id": "withProgrammingHours", "op": "arithmetic", "inputs": ["withSetupHours", "programmingHours"], "params": { "kind": "add" } },
    { "id": "withManualHours", "op": "arithmetic", "inputs": ["withProgrammingHours", "manualHours"], "params": { "kind": "add" } },
    { "id": "laborHours", "op": "arithmetic", "inputs": ["withManualHours", "inspectionHours"], "params": { "kind": "add" } },
    { "id": "laborCost", "op": "arithmetic", "inputs": ["laborHours", "workerCost"], "params": { "kind": "mul" } },
    { "id": "needsCooperation", "op": "compare", "inputs": ["cooperationCost"], "params": { "operator": "gt", "value": 0 } },
    { "id": "lowConfidence", "op": "compare", "inputs": ["confidence"], "params": { "operator": "lt", "value": 0.7 } },
    { "id": "aboveLimit", "op": "compare", "inputs": ["price"], "params": { "operator": "gt", "value": 5000 } },
    { "id": "assumedOrCooperation", "op": "choose", "inputs": ["materialStated", "needsCooperation", "yes"], "params": {} },
    { "id": "orLowConfidence", "op": "choose", "inputs": ["assumedOrCooperation", "yes", "lowConfidence"], "params": {} },
    { "id": "needsReview", "op": "choose", "inputs": ["orLowConfidence", "yes", "aboveLimit"], "params": {} },
    { "id": "autoSend", "op": "compare", "inputs": ["needsReview"], "params": { "operator": "eq", "value": false } },
    { "id": "reasons", "op": "report", "inputs": ["materialStated", "needsCooperation", "lowConfidence", "aboveLimit"], "params": { "labels": ["materialOnDrawing", "cooperation", "lowConfidence", "priceAbove5000"] } },
    { "id": "sendQuote", "op": "action", "inputs": ["autoSend", "price"], "params": { "allowed": true, "action": "send-quote-to-customer" } },
    { "id": "review", "op": "action", "inputs": ["needsReview", "reasons"], "params": { "allowed": true, "action": "route-to-estimator" } }
  ],
  "outputs": ["material", "preparation", "programming", "machining", "manual", "inspection", "cooperationCost", "reserve", "cost", "profit", "marginOfPrice", "price", "pricePerPiece", "laborCost", "sendQuote", "review"]
}
