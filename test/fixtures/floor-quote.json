{
  "format": "auditline-policy",
  "version": 1,
  "name": "Floor quote",
  "inputs": [
    {
      "id": "minutes",
      "name": "minutes",
      "type": {
        "kind": "number",
        "unit": "min",
        "min": 0
      },
      "basis": "confirmed"
    },
    {
      "id": "rate",
      "name": "rate",
      "type": {
        "kind": "number",
        "unit": "PLN*min^-1",
        "min": 0
      },
      "basis": "confirmed"
    },
    {
      "id": "proposed",
      "name": "proposed",
      "type": {
        "kind": "number",
        "unit": "PLN",
        "min": 0
      },
      "basis": "suspected"
    },
    {
      "id": "floor",
      "value": 150,
      "type": {
        "kind": "number",
        "unit": "PLN",
        "min": 0
      }
    }
  ],
  "steps": [
    {
      "id": "machining",
      "op": "arithmetic",
      "inputs": [
        "minutes",
        "rate"
      ],
      "params": {
        "kind": "mul"
      }
    },
    {
      "id": "price",
      "op": "arithmetic",
      "inputs": [
        "machining",
        "floor"
      ],
      "params": {
        "kind": "max"
      }
    },
    {
      "id": "matches",
      "op": "compareValues",
      "inputs": [
        "price",
        "proposed"
      ],
      "params": {
        "operator": "eq"
      }
    },
    {
      "id": "differs",
      "op": "compare",
      "inputs": [
        "matches"
      ],
      "params": {
        "operator": "eq",
        "value": false
      }
    },
    {
      "id": "review",
      "op": "action",
      "inputs": [
        "differs",
        "price"
      ],
      "params": {
        "allowed": true,
        "action": "route-to-human-review"
      }
    }
  ],
  "outputs": [
    "price",
    "matches",
    "review"
  ],
  "rationale": "Price is at least the floor; input basis labels are caller assertions."
}
